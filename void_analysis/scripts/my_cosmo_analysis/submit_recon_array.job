#!/bin/bash
#SBATCH --job-name=BitVF_Revolver
#SBATCH --account=astro
#SBATCH --time=24:00:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=32
#SBATCH --mem=64000
#SBATCH --constraint=blade
#SBATCH --output=logs/bitvf_revolver_%A_%a.out
#SBATCH --array=0-4

# Ensure output directories exist
mkdir -p results logs

# We are processing 50 realizations across 5 nodes
# Array indices 0-4
# Node 0 processes R0 to R9
# Node 1 processes R10 to R19
# etc.

START_IDX=$((SLURM_ARRAY_TASK_ID * 10))
END_IDX=$((START_IDX + 9))

# Using a hypothetical 20p revolver fraction prefix as an example
INPUT_PREFIX="void_analysis/data/raw/DM_particles_revolver_20p"
OUTPUT_PREFIX="bitvf_revolver_20p"

echo "Executing BitVF Recon Job Array Task ID: ${SLURM_ARRAY_TASK_ID}"
echo "Processing realizations ${START_IDX} to ${END_IDX}"

./run_aletheia_recon ${INPUT_PREFIX} ${OUTPUT_PREFIX} ${START_IDX} ${END_IDX}
